<p style="margin: 0 0 16px;">Hi <%= @user.first_name %>,</p>

<% if @membership.nil? || @membership.role == 'member' %>
  <p style="margin: 0 0 8px;">
    You've been added to Cap City's member website<%= " for the #{@membership.season.year} season" if @membership %>. It's where you'll:
  </p>
  <ul style="margin: 0 0 16px; padding-left: 20px;">
    <li>Submit/manage conflicts</li>
    <li>Track dues</li>
    <li>See important files, including music &amp; drill</li>
  </ul>
<% else %>
  <p style="margin: 0 0 16px;">
    You've been added to Cap City's member website for the <%= @membership.season.year %> season.
  </p>
<% end %>

<p style="margin: 0;">
  To get started, choose a password. Enter this email address (<%= @user.email %>) on the next page and we'll send you a link to set one.
</p>

<%= email_button 'Choose your password', @url %>

<p style="margin: 0 0 16px;">After that, sign in with your email address and the password you chose.</p>

<p style="margin: 0;">See you at rehearsal,<br />Cap City</p>
