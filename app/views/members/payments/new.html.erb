<% content_for :page_title, 'Pay dues' %>

<%= javascript_tag do %>
  window.duesPayment = <%== {
    stripePublicKey: @stripe_public_key,
    returnUrl: "#{root_url}members/payments/post_processing",
    owedCents: @owed_cents.to_i,
    owedDueOn: @owed_due_on&.strftime('%a %-m/%-d'),
    pastDueCents: @dues[:past_due].to_i,
    remainingCents: @remaining_cents.to_i,
    prefillCents: params[:amount].present? ? (params[:amount].to_f * 100).round : nil
  }.to_json %>;
<% end %>

<%= vite_typescript_tag 'entrypoints/members/payments/index.tsx' %>

<div class="mx-auto w-full max-w-[640px]">
  <a href="<%= members_home_path %>" class="link text-body-sm">&lsaquo; Where you stand</a>
  <h1>Pay dues</h1>
  <div id="payments"></div>
</div>
