<h1>Calendar Fundraiser</h1>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
  <div class="flex flex-col">
    <div class="card card--success">
      <div class="flex flex-col">
        <div class="card-title text-success-fg">TOTAL</div>
        <span class="text-metric font-mono text-success-fg mb-0.5">$<%= @total %></span>
        <% if @completed.count > 0 %>
          <span class="text-secondary text-body-sm font-medium">Completed fundraisers: <span class="font-bold text-primary"><%= @completed.count %></span></span>
        <% end %>
      </div>
    </div>

    <div class="card mt-4 hidden lg:block flex-grow">
      <span class="card-title">CURRENT DONATIONS</span>
      <ul class="divide-y divide-border-default">
        <% @current.donations.order(:donation_date).each do |donation| %>
          <li class="flex justify-between py-2">
            <span class="text-primary">$<%= donation.donation_date %></span>
            <span class="text-secondary"><%= donation.donor_name.blank? ? 'Anonymous' : donation.donor_name %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <div id="calendars" class="card-flat border-ocean">
  </div>

  <div class="card lg:hidden">
    <span class="card-title">CURRENT DONATIONS</span>
    <ul class="divide-y divide-border-default">
      <% @current.donations.order(:donation_date).each do |donation| %>
        <li class="flex justify-between py-2">
          <span class="text-primary">$<%= donation.donation_date %></span>
          <span class="text-secondary"><%= donation.donor_name.blank? ? 'Anonymous' : donation.donor_name %></span>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<%= vite_typescript_tag 'entrypoints/members/calendars/index.tsx' %>
