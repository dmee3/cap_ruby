<div class="mx-auto w-full max-w-[640px] flex flex-col gap-4">
  <h1>Conflicts aren't open right now</h1>
  <p class="text-body text-secondary">
    We'll let everyone know when conflict submission opens. Have an urgent conflict?
    Reach out to your coordinator.
  </p>

  <div class="card flex flex-col gap-3">
    <span class="card-title">Your conflicts</span>
    <% if @existing_conflicts.empty? %>
      <p class="text-body-sm text-secondary">No conflicts submitted — you're clear for every rehearsal.</p>
    <% else %>
      <ul class="flex flex-col gap-2">
        <% @existing_conflicts.each do |c| %>
          <li class="text-body-sm">
            <%= c.start_date.strftime('%a %-m/%-d') %><%= "–#{c.end_date.strftime('%-m/%-d')}" if c.start_date.to_date != c.end_date.to_date %>
            — <%= c.status.name %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
