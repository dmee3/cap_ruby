<% content_for :page_title, 'Edit conflict' %>

<%= javascript_tag do %>
  window.conflictForm = <%== {
    formAction: members_conflict_path(@conflict),
    authenticityToken: form_authenticity_token,
    method: 'patch',
    submitLabel: 'Save changes',
    defaults: conflict_form_defaults(@conflict),
    errors: conflict_field_errors(@conflict),
    cancelHref: members_conflicts_path
  }.to_json %>;
<% end %>

<%= vite_typescript_tag 'entrypoints/members/conflicts/index.tsx' %>

<div class="mx-auto w-full max-w-[640px] flex flex-col gap-4">
  <%# Edit is reached from the list's Edit link, so back returns to the list
      rather than skipping over it to the dashboard. %>
  <a href="<%= members_conflicts_path %>" class="link text-body-sm">&lsaquo; Your conflicts</a>
  <h1>Edit conflict</h1>

  <div id="conflict-form"></div>

  <%# Per the canvas: the member sees these two, but can't change either. %>
  <div class="card flex flex-col gap-3">
    <div class="flex items-center justify-between gap-3">
      <span class="flex flex-col gap-0.5">
        <span class="text-body-sm font-semibold text-primary">Status</span>
        <span class="text-caption text-secondary">Only a coordinator can change this.</span>
      </span>
      <%# Deliberately the muted pill, not the live StatusPill colors: on this
          screen the status is a locked fact, not a thing being decided. %>
      <span class="rounded-full bg-sunken px-3 py-1 text-caption font-semibold uppercase tracking-wide text-secondary">
        <%= @conflict.status.name %>
      </span>
    </div>
    <div class="flex items-center justify-between gap-3 border-t border-border-default pt-3">
      <span class="flex flex-col gap-0.5">
        <span class="text-body-sm font-semibold text-primary">Member</span>
        <span class="text-caption text-secondary">It&rsquo;s yours, so there&rsquo;s nothing to pick.</span>
      </span>
      <span class="text-body-sm text-secondary"><%= @conflict.user.full_name %></span>
    </div>
  </div>
</div>
