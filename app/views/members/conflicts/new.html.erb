<% content_for :page_title, 'New conflict' %>

<%= javascript_tag do %>
  window.conflictForm = <%== {
    formAction: members_conflicts_path,
    authenticityToken: form_authenticity_token,
    minDate: Date.current.iso8601,
    defaults: conflict_form_defaults(@conflict),
    errors: conflict_field_errors(@conflict),
    cancelHref: members_home_path
  }.to_json %>;
  window.conflictList = <%== conflict_row_data(@existing_conflicts).to_json %>;
<% end %>

<%= vite_typescript_tag 'entrypoints/members/conflicts/index.tsx' %>

<div class="mx-auto w-full max-w-[640px] flex flex-col gap-4">
  <a href="<%= members_home_path %>" class="link text-body-sm">&lsaquo; Where you stand</a>
  <h1>New conflict</h1>

  <div id="conflict-form"></div>

  <%# Always below the form's submit/cancel, never beside it — the page is a
      single column at every width, which is what the Flow 3 boards show. %>
  <div class="card flex flex-col gap-3">
    <div class="flex items-baseline justify-between gap-2">
      <span class="card-title">Already submitted</span>
      <%# Flow 3 puts the season and a count opposite the title. The canvas
          says "Spring 2026"; seasons only store a year, so this uses the same
          "<year> Season" label the season switcher does. %>
      <% submitted_count = @existing_conflicts.to_a.size %>
      <span class="text-caption text-secondary">
        <%= current_season.year %> Season<%= " · #{submitted_count}" if submitted_count.positive? %>
      </span>
    </div>
    <div id="conflict-list"></div>
  </div>
</div>
