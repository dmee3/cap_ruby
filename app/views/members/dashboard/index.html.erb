<% content_for :page_title, 'Dashboard' %>
<%= vite_typescript_tag 'entrypoints/members/index.tsx' %>

<%
  next_installment = @dues[:remaining_installments]&.first
  owed_cents = @dues[:past_due].to_i.positive? ? @dues[:past_due] : next_installment&.dig(:amount)
%>

<div class="flex flex-col gap-1 mb-5">
  <h1 class="mb-0">Where you stand</h1>
  <p class="text-body-sm text-secondary">
    <%= [current_user.full_name, @ensemble, @section].compact.join(' · ') %>
  </p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-4 lg:gap-5">

  <!-- WHERE YOU STAND -->
  <div class="card flex flex-col gap-3 <%= 'card--danger' if @dues[:state] == :behind %><%= 'card--success' if @dues[:state] == :paid_in_full %>">
    <div class="flex items-baseline justify-between gap-2">
      <span class="card-title">Dues progress</span>
      <% case @dues[:state] %>
      <% when :behind %>
        <span class="inline-flex items-center rounded-full bg-danger-bg text-danger-fg px-2 py-0.5 text-label uppercase">Behind</span>
      <% when :ahead %>
        <span class="inline-flex items-center rounded-full bg-success-bg text-success-fg px-2 py-0.5 text-label uppercase">Ahead</span>
      <% when :paid_in_full %>
        <span class="inline-flex items-center rounded-full bg-success-bg text-success-fg px-2 py-0.5 text-label uppercase">Paid in full</span>
      <% when :on_track %>
        <span class="inline-flex items-center rounded-full bg-success-bg text-success-fg px-2 py-0.5 text-label uppercase">On track</span>
      <% end %>
    </div>

    <div id="dues-meter"
         data-paid="<%= @dues[:paid] %>"
         data-total="<%= @dues[:total] %>"
         data-expected="<%= @dues[:expected] %>"
         data-committed="<%= @dues[:past_due] %>"
         data-committed-kind="past-due"
         data-state="<%= @dues[:state].to_s.dasherize %>"></div>

    <% if @dues[:state] == :no_schedule %>
      <p class="text-body border-t border-border-default pt-3">
        Your dues schedule hasn't been set up yet. A director will add it soon — check back, or reach out if you have questions.
      </p>
    <% elsif @dues[:state] == :paid_in_full %>
      <p class="text-body border-t border-border-default pt-3">
        You're all paid up for the season — <strong><%= number_to_currency(@dues[:total] / 100.0) %></strong>. Thanks!
      </p>
    <% elsif owed_cents.to_i.positive? %>
      <p class="text-body border-t border-border-default pt-3">
        <% if @dues[:past_due].to_i.positive? %>
          You're <strong><%= number_to_currency(@dues[:past_due] / 100.0) %></strong> behind.
        <% else %>
          You owe <strong><%= number_to_currency(owed_cents / 100.0) %></strong><% if next_installment %>, due <strong><%= next_installment[:pay_date].strftime('%a %-m/%-d') %></strong><% end %>.
        <% end %>
        That's <strong><%= number_to_currency(StripeFees.total_cents(owed_cents) / 100.0) %></strong> total on a card.
      </p>
      <div class="flex flex-col sm:flex-row gap-2">
        <%= link_to "Pay #{number_to_currency(owed_cents / 100.0)}", new_members_payment_path(amount: format('%.2f', owed_cents / 100.0)), class: 'btn-primary btn-lg' %>
        <%= link_to 'Pay another amount', new_members_payment_path, class: 'btn-gray btn-lg' %>
      </div>
    <% else %>
      <p class="text-body border-t border-border-default pt-3">
        Nothing due right now. Next installment is <strong><%= next_installment[:pay_date].strftime('%a %-m/%-d') %></strong>.
      </p>
      <%= link_to 'Make a payment', new_members_payment_path, class: 'btn-gray btn-lg self-start' %>
    <% end %>
  </div>

  <!-- CONFLICTS SUMMARY -->
  <div class="card flex flex-col gap-3">
    <div class="flex items-baseline justify-between gap-2">
      <span class="card-title">Your conflicts</span>
      <%= link_to 'New', new_members_conflict_path, class: 'btn-primary btn-sm' %>
    </div>

    <% if @just_submitted %>
      <div class="flash flex items-center gap-2 rounded-sm bg-success-bg px-3 py-2">
        <span class="block flex-1 text-body-sm font-semibold text-success-fg">
          Sent. Your coordinators see it now. Approval isn't automatic.
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" class="flash-close h-5 w-5 flex-none cursor-pointer text-success-fg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>
    <% end %>

    <% if @conflicts.any? %>
      <div class="flex flex-wrap gap-2">
        <% @conflicts.group_by { |c| c.status.name }.each do |status, list| %>
          <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-label uppercase
            <%= { 'Pending' => 'bg-warning-bg text-warning-fg', 'Approved' => 'bg-success-bg text-success-fg', 'Denied' => 'bg-danger-bg text-danger-fg' }.fetch(status, 'bg-neutral-bg text-neutral-fg') %>">
            <%= list.count %> <%= status %>
          </span>
        <% end %>
      </div>
      <% if @conflict_nudge %>
        <p class="text-body-sm text-secondary"><%= @conflict_nudge %></p>
      <% end %>
    <% end %>

    <div id="conflict-list" data-conflicts="<%= @conflict_rows.to_json %>"></div>

    <% if @conflicts.count > 4 %>
      <%= link_to "All #{@conflicts.count} conflicts", members_conflicts_path, class: 'self-center text-body-sm font-semibold text-accent-primary' %>
    <% end %>
  </div>

  <!-- DUES TIMELINE -->
  <div class="lg:col-span-2 card p-0 overflow-hidden">
    <div class="flex items-baseline justify-between gap-2 px-4 py-3 border-b border-border-default">
      <span class="text-h3 font-semibold">Dues timeline</span>
      <% if @dues[:state] != :no_schedule %>
        <span class="text-caption text-secondary">
          <%= @timeline[:paid].count %> paid · <%= @timeline[:upcoming].count %> to go
        </span>
      <% end %>
    </div>
    <div id="dues-timeline" data-timeline="<%= @timeline.to_json %>">
      <div class="p-4 flex flex-col gap-3">
        <% 3.times do %><div class="h-3.5 rounded-sm bg-sunken animate-pulse" style="width: <%= [60, 90, 75].sample %>%"></div><% end %>
      </div>
    </div>
  </div>
</div>
