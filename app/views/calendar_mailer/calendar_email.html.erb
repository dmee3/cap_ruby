<p style="margin: 0 0 16px;">Hi <%= @user.first_name %>,</p>

<% if @donor_name.present? %>
  <p style="margin: 0 0 16px;">You've received a calendar donation from <%= @donor_name %>!</p>
<% else %>
  <p style="margin: 0 0 16px;">You've received a calendar donation!</p>
<% end %>

<p style="margin: 0 0 8px;">This donation was for the following dates:</p>
<ul style="margin: 0 0 16px; padding-left: 20px;">
  <% @donation_dates.each do |day| %>
    <li><%= day %></li>
  <% end %>
</ul>

<p style="margin: 0;">You can see all your donations so far and download an image of your latest calendar on the member site.</p>

<%= email_button 'View your calendar', members_calendars_url %>

<p style="margin: 0;">If you have any questions, please reach out to Dan!</p>
