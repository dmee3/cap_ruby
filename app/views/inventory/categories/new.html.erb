<div class="flex max-w-[640px] flex-col gap-4">
  <nav class="text-body-sm text-secondary">
    <%= link_to 'Stock', inventory_categories_path,
                class: 'text-accent-primary underline underline-offset-2' %>
    / New category
  </nav>

  <h1 class="m-0 text-h1 text-primary">Add a category</h1>
  <p class="m-0 text-body-sm text-secondary">
    A shelf, near enough: Sticks, Heads, Uniforms. You can add items to it right after.
  </p>

  <%= form_with model: @category, class: 'flex flex-col gap-4' do |f| %>
    <% if @category.errors.any? %>
      <div class="card border-l-[3px] border-l-danger-fg">
        <p class="m-0 text-body font-semibold text-danger-fg">
          <%= @category.errors.count == 1 ? 'One thing to fix' : "#{@category.errors.count} things to fix" %>
        </p>
        <ul class="mt-2 flex list-none flex-col gap-1 p-0">
          <% @category.errors.full_messages.each do |message| %>
            <li class="text-body-sm text-danger-fg"><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex flex-col gap-1.5">
      <%= f.label :name, 'Category name', class: 'text-label uppercase text-secondary' %>
      <%= f.text_field :name, class: 'input-text' %>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= f.submit 'Add category', class: 'btn-primary btn-lg' %>
      <%= link_to 'Cancel', inventory_categories_path, class: 'btn-secondary btn-lg' %>
    </div>
  <% end %>
</div>
