<%= form_with model: [@rule], class: 'flex flex-col gap-4' do |f| %>
  <% if @rule.errors.any? %>
    <div class="card border-l-[3px] border-l-danger-fg">
      <p class="m-0 text-body font-semibold text-danger-fg">
        <%= @rule.errors.count == 1 ? 'One thing to fix' : "#{@rule.errors.count} things to fix" %>
      </p>
      <ul class="mt-2 flex list-none flex-col gap-1 p-0">
        <% @rule.errors.full_messages.each do |message| %>
          <li class="text-body-sm text-danger-fg"><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# The rule reads as a sentence, so it is edited as one. The slots are real
      selects and a real number input: a native control is keyboard- and
      screen-reader-accessible without a custom focus trap. %>
  <div class="card">
    <div class="flex flex-wrap items-center gap-2 text-body leading-8 text-primary">
      <span>When</span>

      <%= f.label :inventory_item_id, 'Item', class: 'sr-only' %>
      <%= f.grouped_collection_select :inventory_item_id, @categories, :items, :name, :id, :name,
                                      { include_blank: 'Pick an item' },
                                      class: 'input-select h-8 w-auto py-0' %>

      <%= f.label :operator, 'Condition', class: 'sr-only' %>
      <%= f.select :operator, operator_options, { include_blank: 'Pick a condition' },
                   class: 'input-select h-8 w-auto py-0' %>

      <%= f.label :threshold, 'Threshold', class: 'sr-only' %>
      <%= f.number_field :threshold, min: 0,
                         class: 'input-text h-8 w-[72px] py-0 text-center font-mono' %>

      <span>, email</span>

      <%= f.label :mail_to_user_id, 'Who to email', class: 'sr-only' %>
      <%= f.collection_select :mail_to_user_id, @users, :id, :full_name,
                              { include_blank: 'Pick someone' },
                              class: 'input-select h-8 w-auto py-0' %>

      <span>.</span>
    </div>

    <p class="mt-3 text-body-sm text-secondary">
      Alerts email whoever you pick each time a count still meets the condition.
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit(@rule.persisted? ? 'Save alert' : 'Add alert', class: 'btn-primary btn-lg') %>
    <%= link_to 'Cancel', inventory_email_rules_path, class: 'btn-gray btn-lg' %>
  </div>
<% end %>
