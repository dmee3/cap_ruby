<div class="flex flex-col gap-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="m-0 text-h1 text-primary">Low-stock alerts</h1>
    <%= link_to 'New alert', new_inventory_email_rule_path, class: 'btn-primary btn-lg' %>
  </div>

  <p class="m-0 text-body-sm text-secondary">
    <% if @rules.any? %>
      <%= pluralize(@rules.length, 'alert') %>
      <%= @rules.length == 1 ? 'is watching' : 'are watching' %>
      <%= pluralize(@watched_item_count, 'item') %>.
      <% if @unwatched_count.positive? %>
        Everything else runs unwatched.
      <% end %>
    <% end %>
  </p>

  <div class="card p-0">
    <% if @rules.empty? %>
      <div class="flex flex-col items-center gap-2 px-6 py-8 text-center">
        <p class="m-0 text-body font-semibold text-primary">No alerts set up</p>
        <p class="m-0 max-w-[340px] text-body-sm text-secondary">
          Add one so you hear about low stock before it's a problem. Pick an item, a number, and who gets the email.
        </p>
        <%= link_to 'Add your first alert', new_inventory_email_rule_path, class: 'btn-primary btn-md mt-1' %>
      </div>
    <% else %>
      <ul class="flex flex-col">
        <% @rules.each do |rule| %>
          <li class="flex flex-wrap items-center gap-3 border-b border-border-default px-4 py-3 last:border-b-0">
            <span class="min-w-0 flex-1 text-body text-primary">
              When <strong class="font-bold"><%= rule.inventory_item.name %></strong>
              is <strong class="font-bold"><%= operator_label(rule.operator) %> <%= rule.threshold %></strong>,
              email <strong class="font-bold"><%= rule.user.full_name %></strong>.
            </span>

            <% if rule.applies_to?(rule.inventory_item.quantity) %>
              <span class="rounded-full bg-warning-bg px-2 py-[2px] text-label uppercase text-warning-fg">
                Firing now
              </span>
            <% end %>

            <%= link_to 'Edit', edit_inventory_email_rule_path(rule),
                        class: 'inline-flex min-h-[44px] items-center px-2 text-body-sm text-accent-primary underline underline-offset-2' %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% if @unwatched_zero.present? %>
    <div class="card border-l-[3px] border-l-warning-fg">
      <p class="m-0 text-body text-primary">
        <strong class="font-bold"><%= @unwatched_zero.name %></strong> is at zero with no alert on it.
        That is the gap alerts are for.
      </p>
      <%= link_to "Add one for #{@unwatched_zero.name}",
                  new_inventory_email_rule_path(inventory_item_id: @unwatched_zero.id),
                  class: 'btn-secondary btn-md mt-3' %>
    </div>
  <% end %>
</div>
