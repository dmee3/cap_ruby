<%# Server-rendered counterpart to the React <Toast> component. Both render the
    same shape — dot, message, dismiss — in the same bottom-right stack, so a
    redirect-driven flash and a JS-driven toast are indistinguishable to the
    user. Keys that drive UI elsewhere (an inline banner, an undo affordance)
    carry no message and are skipped here. %>
<% renderable = flash.flat_map { |type, messages|
     Array.wrap(messages).filter_map { |m| [type, m] if flash_message?(type, m) }
   } %>

<% if renderable.any? %>
  <div id="flash-bar" class="flash-bar">
    <% renderable.each do |type, message| %>
      <div data-dismissible role="status" class="flash <%= flash_color(type) %>">
        <span class="flash-dot"></span>
        <span class="block flex-1 text-body-sm font-medium"><%= message %></span>
        <button type="button" data-dismiss aria-label="Dismiss" class="flash-close">&times;</button>
      </div>
    <% end %>
  </div>
<% end %>
