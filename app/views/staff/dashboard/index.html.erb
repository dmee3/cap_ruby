<% content_for :page_title, 'Dashboard' %>
<%= vite_typescript_tag 'entrypoints/files/index.tsx' %>
<%= vite_typescript_tag 'entrypoints/staff/index.tsx' %>

<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-5">
  <h1 class="m-0 text-h3 text-primary">Overview</h1>
  <span class="text-body-sm text-secondary"><%= "#{current_season['year']} season" %></span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
  <div class="lg:col-span-2">
    <div
      id="staff-conflicts"
      data-groups="<%= @date_groups.to_json %>"
      data-out-count="<%= @out_count %>"
      data-window-label="<%= @window_label %>"
    ></div>
  </div>

  <div class="flex flex-col gap-4">
    <div class="bg-surface border border-border-default rounded-md overflow-hidden">
      <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-b border-border-default px-4 py-3.5">
        <span class="text-h3 text-primary">Season files</span>
        <%= link_to 'All files', files_path, class: 'link text-body-sm ml-auto shrink-0' %>
      </div>
      <div id="files" data-season="<%= current_season['year'] %>" data-limit="3"></div>
    </div>
  </div>
</div>
