<%#
  The season list a switcher trigger opens. Shared by the full sidebar/drawer
  switcher and the topbar's compact season chip, so both name the same
  seasons in the same order rather than keeping two copies in sync.
  locals: menu_id, align (:left or :right — which edge the trigger sits near)
%>
<% return unless current_user %>
<% seasons = current_user.seasons.order(:year).reverse %>
<% align ||= :left %>
<div id="<%= menu_id %>" class="hidden absolute <%= align == :right ? 'right-0' : 'left-0' %> mt-2 w-72 max-w-[calc(100vw-2rem)] max-h-[70vh] overflow-y-auto z-50 bg-surface-raised text-primary rounded-md shadow-e2 border border-border-default p-1.5">
  <% seasons.each_with_index do |season, i| %>
    <% if i.zero? %>
      <div class="px-2.5 pt-2 pb-1 text-label uppercase text-secondary">Current</div>
    <% elsif i == 1 %>
      <div class="px-2.5 pt-2 pb-1 text-label uppercase text-secondary">Past</div>
    <% end %>
    <% selected = current_season && current_season['id'] == season.id %>
    <%= form_with url: change_season_path, method: :post do |f| %>
      <%= f.hidden_field :season_id, value: season.id, id: nil %>
      <button type="submit"
              class="w-full flex items-center gap-2 p-2.5 rounded-sm text-left cursor-pointer transition <%= selected ? 'bg-[color:rgb(var(--accent-primary)/0.12)]' : 'hover:bg-sunken' %>">
        <span class="flex-1">
          <span class="block font-<%= selected ? 'bold' : 'semibold' %> <%= 'text-ocean-dark' if selected %>"><%= season.year %> Season</span>
        </span>
        <% if selected %>
          <svg class="h-4 w-4 text-ocean shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </button>
    <% end %>
  <% end %>
</div>
