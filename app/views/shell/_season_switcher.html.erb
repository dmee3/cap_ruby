<%#
  Season switcher — a scope control, not a settings menu. locals: menu_id
%>
<% return unless current_user %>
<% menu_id ||= 'season-menu' %>
<div class="relative">
  <button type="button"
          data-dropdown-trigger
          aria-controls="<%= menu_id %>"
          aria-haspopup="true"
          class="w-full bg-surface-raised border border-border-default rounded-md px-3 py-2 flex items-center justify-between gap-2 cursor-pointer hover:border-ocean-light transition">
    <span class="flex flex-col text-left">
      <span class="text-label uppercase text-secondary">Season</span>
      <span class="font-bold text-primary leading-tight"><%= current_season ? "#{current_season['year']} Season" : '—' %></span>
    </span>
    <svg class="h-4 w-4 text-secondary shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </button>

  <%= render 'shell/season_switcher_menu', menu_id: menu_id, align: :left %>
</div>
