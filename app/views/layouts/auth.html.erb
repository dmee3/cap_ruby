<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Cap City Percussion</title>
    <%= csrf_meta_tags %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
  </head>

  <body class="bg-page text-primary min-h-screen">
    <% if flash.present? %>
      <%= render 'flashes' %>
    <% end %>

    <div class="min-h-screen flex items-center justify-center p-4">
      <main class="card w-full max-w-sm">
        <div class="flex justify-center mb-6">
          <%= image_tag vite_asset_path('images/full_logo_small.png'), alt: 'Cap City Percussion', class: 'max-h-12 w-auto' %>
        </div>
        <%= yield %>
      </main>
    </div>

    <%= yield :scripts %>
  </body>
</html>
