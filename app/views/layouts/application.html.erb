<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:page_title) ? "#{strip_tags(yield(:page_title))} · Cap City Percussion" : 'Cap City Percussion' %></title>
    <%= csrf_meta_tags %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
  </head>

  <body class="bg-page text-primary min-h-screen">
    <div class="flex min-h-screen">
      <%= render 'shell/sidebar' %>

      <div class="flex-1 min-w-0 flex flex-col">
        <%= render 'shell/topbar' %>

        <main id="main-content">
          <% if flash.present? %>
            <%= render 'flashes' %>
          <% end %>
          <%= yield %>
        </main>
      </div>
    </div>

    <%= render 'shell/drawer' %>

    <%= yield :scripts %>
  </body>
</html>
