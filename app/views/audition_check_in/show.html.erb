<% content_for :page_title, 'Audition check-in' %>
<% running = @run&.in_progress? %>
<% report = @run&.sync_report %>
<% can_start = AuditionCheckIn::Sync.enabled? && !running %>

<div class="flex justify-center py-8 sm:py-16">
  <section class="card w-full max-w-[560px] rounded-lg p-7 sm:p-8" aria-labelledby="check-in-heading">
    <p class="card-title">Auditions</p>
    <h1 id="check-in-heading" class="m-0 mt-1 text-h1 text-primary">Build the feedback sheet and docs</h1>
    <p class="text-body text-secondary mt-2">
      Puts everyone who's filled in the check-in form on their section's tab and doc,
      with pronouns and birthday from their registration and their selfie in the doc.
    </p>

    <% if running %>
      <div class="mt-6 rounded-md border border-border-default bg-sunken p-5" role="status" aria-live="polite">
        <p class="m-0 text-h3 text-primary">Running…</p>
        <p class="text-body-sm text-secondary mt-2 mb-0">
          Started <%= time_ago_in_words(@run.created_at) %> ago. It usually takes under a minute —
          this page checks again every few seconds, and it's fine to close it.
        </p>
      </div>
    <% elsif report %>
      <div class="mt-6 rounded-md bg-success-bg p-5" role="status">
        <p class="m-0 text-h3 text-success-fg">
          Done. <%= pluralize(report.people_written, 'person') %> on the feedback sheet and docs.
        </p>
        <p class="text-caption text-secondary mt-1 mb-0">
          Finished <%= time_ago_in_words(@run.finished_at) %> ago
          (<%= @run.finished_at.in_time_zone('America/New_York').strftime('%a %-m/%-d, %-l:%M %p') %>).
        </p>
        <ul class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-1 text-body-sm list-none p-0">
          <% report.written.each do |tab, count| %>
            <li class="flex justify-between gap-2">
              <span class="text-secondary"><%= tab %></span>
              <span class="font-mono tabular-nums"><%= count %></span>
            </li>
          <% end %>
        </ul>
        <p class="text-body-sm mt-3 mb-0">
          <%= report.matched %> of <%= report.matched + report.unmatched %> matched to a registration.
          <% if report.unmatched.positive? %>
            The other <%= report.unmatched %> have blank pronouns and birthday — neither their name nor
            their email is on the Registrations tab.
          <% end %>
        </p>
        <p class="text-body-sm mt-2 mb-0">
          <%= pluralize(report.photos, 'selfie') %> in the docs.
          <% if report.missing_photos.positive? %>
            <%= report.missing_photos %> didn't have one Drive could open, so their doc says "No selfie".
          <% end %>
        </p>
        <% if report.duplicates.positive? %>
          <p class="text-body-sm mt-2 mb-0">
            <%= pluralize(report.duplicates, 'repeat check-in') %> replaced by that person's latest one.
          </p>
        <% end %>
      </div>

      <% if report.unknown_instruments.any? %>
        <div class="card card--warning mt-4" role="alert">
          <p class="m-0 text-body text-primary">
            <%= pluralize(report.unknown_instruments.values.sum, 'check-in') %> left off —
            their instrument has no tab:
            <%= report.unknown_instruments.map { |instrument, count| "#{instrument.presence || '(blank)'} (#{count})" }.to_sentence %>.
          </p>
        </div>
      <% end %>
    <% elsif @run&.failed? %>
      <div class="card card--danger mt-6" role="alert">
        <p class="m-0 text-h3 text-danger-fg">That didn't work.</p>
        <p class="text-body mt-2 mb-0"><%= @run.error_message %></p>
      </div>
    <% end %>

    <% links = { 'Open the feedback sheet' => AuditionCheckIn::Sync.feedback_sheet_url,
                 'Open the section docs' => AuditionCheckIn::Sync.feedback_docs_url }.compact %>
    <% if links.any? %>
      <p class="flex flex-wrap gap-x-6 gap-y-1 text-body-sm mt-6 mb-0">
        <% links.each do |label, url| %>
          <%= link_to label, url, class: 'link', target: '_blank', rel: 'noopener' %>
        <% end %>
      </p>
    <% end %>

    <% if can_start %>
      <div id="sync-start" class="mt-6">
        <button type="button" id="sync-start-button" class="btn-primary btn-lg w-full sm:w-full"
                aria-controls="sync-confirm" aria-expanded="false">
          <%= report ? 'Sync again' : 'Sync check-ins' %>
        </button>
      </div>

      <div id="sync-confirm" hidden
           class="mt-6 rounded-md border border-border-default border-t-4 border-t-danger-fg bg-danger-bg p-5 sm:p-6">
        <h2 id="sync-confirm-heading" tabindex="-1" class="m-0 text-h2 text-danger-fg focus:outline-none">Are you sure?</h2>
        <p class="text-body text-primary mt-2">
          This <strong>overwrites the feedback sheet and every section doc</strong>. Each tab is cleared
          below its header and each doc is replaced, all rebuilt from the check-in form — any feedback
          already written in either is gone.
        </p>
        <p class="text-body-sm text-secondary mt-2">Only run it before staff start writing feedback.</p>

        <%= form_with url: audition_check_in_path, method: :post, id: 'sync-form', class: 'mt-5' do %>
          <button type="submit" id="sync-submit" class="btn-red btn-lg w-full sm:w-full">
            Yes, overwrite the sheet and docs
          </button>
        <% end %>
        <button type="button" id="sync-cancel" class="btn-gray btn-md w-full sm:w-full mt-3">Cancel</button>
      </div>
    <% else %>
      <div class="mt-6">
        <button type="button" class="btn-primary btn-lg w-full sm:w-full" disabled aria-describedby="sync-off">
          <%= running ? 'Running…' : 'Sync check-ins' %>
        </button>
        <% unless AuditionCheckIn::Sync.enabled? %>
          <p id="sync-off" class="text-body-sm text-secondary mt-3 mb-0">
            Turned off until next season's auditions — this season's feedback sheet and docs are done,
            and running it again would erase the feedback written in them.
          </p>
        <% end %>
      </div>
    <% end %>
  </section>
</div>

<% if running %>
  <% content_for :scripts do %>
    <script type="text/javascript">
      setTimeout(function () { window.location.reload() }, 5000)
    </script>
  <% end %>
<% elsif can_start %>
  <% content_for :scripts do %>
    <script type="text/javascript">
      (function () {
        var start = document.getElementById('sync-start')
        var startButton = document.getElementById('sync-start-button')
        var confirm = document.getElementById('sync-confirm')
        var heading = document.getElementById('sync-confirm-heading')
        var form = document.getElementById('sync-form')
        var submit = document.getElementById('sync-submit')

        function open() {
          start.hidden = true
          startButton.setAttribute('aria-expanded', 'true')
          confirm.hidden = false
          heading.focus()
        }

        function close() {
          if (submit.disabled) return
          confirm.hidden = true
          start.hidden = false
          startButton.setAttribute('aria-expanded', 'false')
          startButton.focus()
        }

        startButton.addEventListener('click', open)
        document.getElementById('sync-cancel').addEventListener('click', close)
        confirm.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') close()
        })

        form.addEventListener('submit', function (event) {
          if (submit.disabled) {
            event.preventDefault()
            return
          }
          submit.disabled = true
          submit.setAttribute('aria-busy', 'true')
          submit.textContent = 'Starting…'
        })
      })()
    </script>
  <% end %>
<% end %>
