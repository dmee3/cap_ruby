<h1 class="auth-card-heading">Set a new password</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render 'devise/shared/error_messages', resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="flex flex-col mt-6">
    <%= f.label :password, 'New password', class: 'input-label' %>
    <%= f.password_field :password, autofocus: true, autocomplete: 'new-password', class: 'input-text' %>
    <% if @minimum_password_length %>
      <span class="text-caption text-secondary mt-1">
        <%= "#{@minimum_password_length} characters or more" %>
      </span>
    <% end %>
  </div>

  <div class="flex flex-col mt-4">
    <%= f.label :password_confirmation, 'New password again', class: 'input-label' %>
    <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'input-text' %>
  </div>

  <div class="mt-6">
    <%= f.submit 'Save and log in', class: 'btn-primary btn-lg w-full sm:w-full' %>
  </div>
<% end %>
