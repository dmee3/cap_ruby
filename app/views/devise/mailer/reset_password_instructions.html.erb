<p style="margin: 0 0 16px;">Hi <%= @resource.first_name %>,</p>

<p style="margin: 0;">Use the button below to choose a password for the Cap City member website.</p>

<%= email_button 'Choose your password', edit_password_url(@resource, reset_password_token: @token) %>

<p style="margin: 0 0 16px;">
  The link works for <%= distance_of_time_in_words(Devise.reset_password_within) %>. After that, ask for a new one from the sign-in page.
</p>

<p style="margin: 0;">If you didn't request a password reset, you can ignore this.</p>
