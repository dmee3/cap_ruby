<h1 class="auth-card-heading">Log in</h1>

<%# A failed attempt arrives as a flash from Devise, so the strip below it
    points at recovery rather than repeating the message. %>
<% failed_attempt = flash[:alert].present? %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="flex flex-col mt-6">
    <%= f.label :email, class: 'input-label' %>
    <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'input-text' %>
  </div>

  <div class="flex flex-col mt-4">
    <%= f.label :password, class: 'input-label' %>
    <%= f.password_field :password, autocomplete: 'current-password', class: 'input-text' %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex flex-row items-center gap-2 mt-4">
      <%= f.check_box :remember_me, class: 'input-checkbox' %>
      <%= f.label :remember_me, 'Keep me logged in on this device', class: 'text-body-sm' %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= f.submit 'Log in', class: 'btn-primary btn-lg w-full sm:w-full' %>
  </div>
<% end %>

<div class="auth-footer-strip <%= 'auth-footer-strip--accented' if failed_attempt %>">
  <p class="text-body-sm text-secondary">Forgot your password?</p>
  <%= link_to 'Email me a reset link', new_password_path(resource_name),
              class: 'btn-gray btn-md w-full sm:w-full mt-3' %>
  <p class="text-caption text-secondary mt-3">
    Can't get in and the reset email never arrives? Ask an admin to check the email on your account.
  </p>
</div>
