<p style="margin: 0 0 16px;">Hi <%= @user.first_name %>,</p>

<% case @rule.operator.to_sym %>
<% when :eq %>
  <p style="margin: 0;">This email is to notify you that Cap City's <%= @item_name %> stock is currently at <%= @rule.threshold %>.</p>
<% when :lt %>
  <p style="margin: 0;">This email is to notify you that Cap City's <%= @item_name %> stock has fallen below <%= @rule.threshold %>.</p>
<% when :lt_eq %>
  <p style="margin: 0;">This email is to notify you that Cap City's <%= @item_name %> stock has dropped to <%= @rule.threshold %>.</p>
<% when :gt %>
  <p style="margin: 0;">This email is to notify you that Cap City's <%= @item_name %> stock has grown past <%= @rule.threshold %>.</p>
<% when :gt_eq %>
  <p style="margin: 0;">This email is to notify you that Cap City's <%= @item_name %> stock has reached <%= @rule.threshold %>.</p>
<% end %>

<%= email_button 'View the inventory', inventory_categories_url %>
