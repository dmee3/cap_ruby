<% content_for :page_title, 'Report a concern' %>
<%= vite_typescript_tag 'entrypoints/whistleblowers/form.tsx' %>

<div class="flex flex-col gap-5 max-w-[760px]">
  <div>
    <h1>Report a concern</h1>
    <p class="text-body-sm text-secondary mt-1">
      Report anything you've seen that worries you. Nobody can retaliate against you for sending this.
    </p>
  </div>

  <div id="whistleblower-form" data-whistleblower-form="<%= @form.to_json %>">
    <div class="flex flex-col gap-4">
      <div class="h-40 rounded-md bg-sunken animate-pulse"></div>
      <div class="h-64 rounded-md bg-sunken animate-pulse"></div>
    </div>
  </div>
</div>
