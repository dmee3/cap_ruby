<%#
  §4.18 summary, scoped to one section. locals: errors (array of {field, message}), lead.
  Each operation renders its own, so a failure in one leaves the other alone.
%>
<% if errors.any? %>
  <div class="card card--danger bg-danger-bg mt-4">
    <span class="text-body font-bold text-danger-fg">
      <%= "#{lead} #{errors.length == 1 ? 'One thing' : "#{errors.length} things"} to fix" %>
    </span>
    <ul class="flex flex-col gap-1.5 mt-2">
      <% errors.each do |error| %>
        <li class="text-body-sm font-medium text-primary">· <%= error[:message] %></li>
      <% end %>
    </ul>
  </div>
<% end %>
