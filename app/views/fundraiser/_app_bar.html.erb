<%# The fundraiser's own top bar. The `public` layout is deliberately
    chrome-free for utility pages (the auditions sheet, the tarp tool), but this
    is the one public flow an outsider judges the ensemble by, so it gets
    branding. Shared across all four screens.

    `right` is optional: the picker shows the season, the inner screens show a
    way back. %>
<div class="border-b border-border-default bg-surface">
  <div class="mx-auto flex h-14 max-w-[1100px] items-center gap-3 px-4 sm:h-16 sm:px-10">
    <a href="/fundraiser" class="flex items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2">
      <span class="h-[26px] w-[26px] flex-none rounded-md bg-raspberry sm:h-[30px] sm:w-[30px]" aria-hidden="true"></span>
      <span class="text-[15px] font-extrabold tracking-tight text-primary sm:text-[16px]">
        Cap City Percussion
      </span>
    </a>

    <% if local_assigns[:right].present? %>
      <span class="ml-auto text-body-sm text-secondary"><%= right %></span>
    <% end %>

    <% if local_assigns[:back_path].present? %>
      <a href="<%= back_path %>" class="link ml-auto text-body-sm">
        <%= local_assigns[:back_label] || 'All performers' %>
      </a>
    <% end %>
  </div>
</div>
