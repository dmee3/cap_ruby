<% content_for :page_title, @user.full_name %>
<%= vite_typescript_tag 'entrypoints/admin/users/show.tsx' %>

<div class="flex items-center justify-between gap-3 mb-4">
  <h1 class="mb-0"><%= @user.full_name %></h1>
  <div class="flex gap-2">
    <%= link_to 'Add payment', new_admin_payment_path(user_id: @user.id), class: 'btn-green btn-lg' %>
    <%= link_to 'Edit user', edit_admin_user_path(@user), class: 'btn-primary btn-lg' %>
  </div>
</div>

<div id="member-360" data-member-360="<%= @member360.to_json %>">
  <div class="flex flex-col gap-4">
    <div class="h-40 rounded-md bg-sunken animate-pulse"></div>
    <div class="h-64 rounded-md bg-sunken animate-pulse"></div>
  </div>
</div>
