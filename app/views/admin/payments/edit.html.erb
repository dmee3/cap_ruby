<% content_for :page_title, 'Edit payment' %>
<%= vite_typescript_tag 'entrypoints/admin/payments/edit.tsx' %>

<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-5">
  <%= link_to '‹ Payments', admin_payments_path,
              class: 'basis-full text-body-sm font-medium text-accent-primary no-underline hover:underline' %>
  <h1 class="m-0 text-h3 text-primary">Edit payment</h1>
  <span class="text-body-sm text-secondary">
    Recorded <%= @payment.created_at.strftime('%-m/%-d/%y') %>
  </span>
</div>

<div
  id="edit-payment"
  data-members="<%= @members.to_json %>"
  data-payment-types="<%= @payment_types.to_json %>"
<%# originalAmountCents is what's currently BANKED for this payment — the
    projection panel nets it out. On a failed update @payment carries the
    rejected values, so read the persisted amount, not the in-memory one. %>
  data-editing="<%= { id: @payment.id,
                      originalAmountCents: @payment.amount_in_database }.to_json %>"
  data-server-errors="<%= (@payment.errors.any? ? @payment.errors.full_messages : []).to_json %>"
  data-initial="<%= { userId: @payment.user_id,
                      paymentTypeId: @payment.payment_type_id,
                      amountCents: @payment.amount,
                      datePaid: @payment.date_paid&.iso8601,
                      notes: @payment.notes }.to_json %>"
></div>
