<% content_for :page_title, 'Payments' %>
<%= vite_typescript_tag 'entrypoints/admin/payments/index.tsx' %>

<div class="flex items-center justify-between gap-3 mb-4">
  <h1 class="mb-0">Payments</h1>
  <%= link_to 'Add manual payment', new_admin_payment_path, class: 'btn-green btn-lg' %>
</div>

<div
  id="admin-payments"
  data-payment-types="<%= @payment_types.to_json %>"
  data-just-created="<%= flash[:undo_payment_id] %>"
>
  <div class="flex flex-col gap-3">
    <% 4.times do %>
      <div class="h-12 rounded-sm bg-sunken animate-pulse"></div>
    <% end %>
  </div>
</div>
