<% content_for :page_title, "#{@editor[:member][:name]} — payment schedule" %>
<%= vite_typescript_tag 'entrypoints/admin/payment_schedules/edit.tsx' %>

<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-5">
  <%= link_to "‹ #{@editor[:member][:name]}", admin_user_path(@editor[:member][:id]),
              class: 'basis-full text-body-sm font-medium text-accent-primary no-underline hover:underline' %>
  <h1 class="m-0">Payment schedule</h1>
  <span class="text-body-sm text-secondary">
    <%= [@editor[:member][:ensemble], @editor[:member][:section],
         @editor[:member][:member_type], "#{@editor[:season_label]} season"].compact.join(' · ') %>
  </span>
</div>

<div id="schedule-editor" data-editor="<%= @editor.to_json %>">
  <div class="flex flex-col gap-4">
    <div class="h-24 rounded-md bg-sunken animate-pulse"></div>
    <div class="h-64 rounded-md bg-sunken animate-pulse"></div>
  </div>
</div>
