<% card = @defaults_card %>
<% tone = {
     'danger' => { rail: 'border-l-danger-fg', title: 'text-danger-fg', pill: 'bg-danger-bg text-danger-fg' },
     'warning' => { rail: 'border-l-warning-fg', title: 'text-warning-fg', pill: 'bg-warning-bg text-warning-fg' },
     'neutral' => { rail: '', title: 'text-secondary', pill: 'bg-neutral-bg text-neutral-fg' }
   }.fetch(card[:tone]) %>

<div class="flex flex-col gap-5">
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h1 class="m-0"><%= @season.year %> season</h1>
    <span class="text-body-sm text-secondary"><%= pluralize(@overview[:member_count], 'member') %></span>
  </div>

  <div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-2">
    <div class="card flex flex-col gap-4">
      <span class="card-title">Conflict submission</span>

      <%= form_for @season, url: admin_season_path, method: :patch do |f| %>
        <% if flash.now[:error] %>
          <p class="text-danger-fg text-body-sm"><%= flash.now[:error] %></p>
        <% end %>

        <label class="input-toggle-wrapper gap-3">
          <%= f.check_box :conflict_submission_open, class: 'input-toggle' %>
          <span class="input-toggle-bg"></span>
          <span class="input-toggle-dot"></span>
          <span class="text-body">
            Members can submit conflicts
            <span class="block text-body-sm text-secondary">
              Off by default each season
            </span>
          </span>
        </label>

        <div class="mt-4">
          <%= f.submit 'Save', class: 'btn-primary btn-lg' %>
        </div>
      <% end %>
    </div>

    <section class="flex flex-col gap-3 rounded-md border border-border-default bg-surface px-5 py-4 <%= tone[:rail].present? ? "border-l-[3px] #{tone[:rail]}" : '' %>"
             aria-labelledby="default-schedules-title">
      <div class="flex items-center gap-3">
        <h2 id="default-schedules-title" class="m-0 text-caption font-semibold uppercase tracking-wide <%= tone[:title] %>">
          Default payment schedules
        </h2>
        <span class="ml-auto rounded-full px-2 py-0.5 text-caption font-semibold <%= tone[:pill] %>"><%= card[:pill] %></span>
      </div>

      <div class="flex flex-col gap-1">
        <span class="text-h3 font-bold text-primary"><%= card[:headline] %></span>
        <span class="text-body-sm text-secondary"><%= card[:body] %></span>
      </div>

      <% if card[:missing].any? %>
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
          <% card[:missing].each do |missing| %>
            <li class="flex justify-between gap-3 text-body-sm">
              <span class="text-primary"><%= missing[:label] %></span>
              <span class="text-secondary"><%= pluralize(missing[:member_count], 'member') %></span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <div>
        <% if card[:cta][:primary] %>
          <%= link_to card[:cta][:label], admin_season_default_schedules_path, class: 'btn-primary btn-md' %>
        <% else %>
          <%= link_to card[:cta][:label], admin_season_default_schedules_path,
                      class: 'text-body-sm font-semibold text-accent-primary no-underline hover:underline' %>
        <% end %>
      </div>
    </section>
  </div>
</div>
