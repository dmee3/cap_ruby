<% content_for :page_title, 'Dashboard' %>
<%= vite_typescript_tag 'entrypoints/files/index.tsx' %>
<%= vite_typescript_tag 'entrypoints/coordinators/index.tsx' %>

<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-5">
  <h1 class="m-0 text-h3 text-primary">Dashboard</h1>
  <span class="text-body-sm text-secondary">
    <%= "#{current_season['year']} season" %>
    <% if @next_event %>
      · Next: <%= @next_event.name %>
    <% end %>
  </span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
  <div class="lg:col-span-2">
    <div
      id="triage-dashboard"
      data-rows="<%= @review_rows.to_json %>"
      data-statuses="<%= ConflictStatus.all.order(:name).map { |s| { id: s.id, name: s.name } }.to_json %>"
      data-pending-count="<%= @pending_count %>"
      data-oldest-member="<%= @oldest && @oldest[:member] %>"
      data-oldest-waiting-days="<%= @oldest && @oldest[:waiting_days] %>"
    ></div>
  </div>

  <div class="flex flex-col gap-4">
    <div class="card flex flex-col gap-3">
      <span class="card-title">Files</span>
      <div id="files"></div>
    </div>
  </div>
</div>
